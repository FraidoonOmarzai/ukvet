# Copy to vllm.env (git-ignored) and fill in. Never commit real keys.
VLLM_TAG=REPLACE-with-a-pinned-vllm-version
MODEL=REPLACE-with-the-huggingface-model-id
VLLM_API_KEY=REPLACE-with-a-long-random-string
HF_TOKEN=
MAX_MODEL_LEN=8192
DTYPE=auto
# Structured output / tool calling flags differ per model. Check the model card and vLLM docs.
VLLM_EXTRA_ARGS=
