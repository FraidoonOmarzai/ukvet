# ukvet API: FastAPI + LangGraph agent + the ukvet-mcp server (spawned as a stdio subprocess).
# Build from the repo root:  docker build -f docker/Dockerfile.api -t ukvet-api .
# NOTE: written and reviewed, but NOT built or run in the environment this was authored in.

FROM python:3.12-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
# The workspace needs every member's pyproject to resolve, even ones we do not install.
COPY pyproject.toml uv.lock ./
COPY ui/pyproject.toml ui/pyproject.toml
COPY packages packages
RUN uv sync --frozen --no-dev --no-editable --package ukvet-agent

FROM python:3.12-slim
RUN useradd --system --create-home --uid 10001 ukvet && mkdir /data && chown ukvet /data
COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    UKVET_HOST=0.0.0.0 \
    UKVET_PORT=8000 \
    UKVET_CACHE_PATH=/data/ch_cache.sqlite
USER ukvet
WORKDIR /home/ukvet
VOLUME /data
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/health', timeout=4)"
CMD ["python", "-m", "ukvet_agent"]
