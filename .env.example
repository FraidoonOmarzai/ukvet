# Copy to .env and fill in. Never commit .env.

# --- Companies House (required) ---
# REST API key, live environment: https://developer.company-information.service.gov.uk/
CH_API_KEY=b28a9526-87b4-4085-9857-7d1c15e2ba9d

# --- Narrative writer (optional). Default: no LLM, reports use a template narrative. ---
# Everything factual in a report comes from rules, not the LLM; the LLM only writes the wording,
# and every sentence is checked against the facts before it is shown.
# none | openai | anthropic | openai_compatible
LLM_PROVIDER=none
# e.g. a model id from your provider's docs (required if provider != none)
# LLM_MODEL=
# required for openai / anthropic
# LLM_API_KEY=
# required for openai_compatible (Groq, Together, OpenRouter, Ollama...)
# LLM_BASE_URL=
# leave unset unless your model supports it
# LLM_TEMPERATURE=
# per attempt; the Reporter makes at most 2 attempts
# LLM_TIMEOUT_SECONDS=15

# --- Agent (all optional) ---
# UKVET_REQUEST_TIMEOUT_SECONDS=45
# UKVET_TOOL_TIMEOUT_SECONDS=20
# directors whose other appointments are checked (Q8)
# UKVET_MAX_DIRECTORS=5
# verifier retries for failed tool calls
# UKVET_MAX_LOOPS=2
# protects the 600 requests / 5 min Companies House limit
# UKVET_MAX_CONCURRENT_REPORTS=4
# "recent" for Q9
# UKVET_CHANGES_WINDOW_DAYS=365
# UKVET_HOST=127.0.0.1
# UKVET_PORT=8000
# used by the Streamlit UI
# UKVET_API_URL=http://localhost:8000

# --- MCP server (all optional) ---
# UKVET_CACHE_TTL_HOURS=24
# UKVET_CACHE_PATH=
# UKVET_CACHE_ENABLED=true

# --- Later phases ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=